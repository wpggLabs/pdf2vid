{
  "name": "pdf2vid",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "ci:lint": "biome ci",
    "check": "npm run ci:lint && npm run test && npm run build && npm run tauri build -- --debug",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "fetch-ffmpeg:all": "node scripts/fetch-ffmpeg.js all",
    "build:win": "node scripts/fetch-ffmpeg.js win-x86_64 && npm run tauri build",
    "build:mac": "node scripts/fetch-ffmpeg.js mac && npm run tauri build",
    "build:linux": "node scripts/fetch-ffmpeg.js linux-x86_64 && npm run tauri build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
